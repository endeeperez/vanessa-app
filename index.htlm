<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculadora Abasto Vanessa</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23667eea'/><text x='50' y='72' font-size='65' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'>AV</text></svg>">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh; padding: 15px;
        display: flex; justify-content: center;
    }
    .container { max-width: 1100px; width: 100%; background: #fff; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,.3); overflow: hidden; }
    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; padding: 30px; text-align: center; }
    .header h1 { font-size: 2rem; margin-bottom: 10px; font-weight: 700; }
    .header p { opacity: .9; font-size: 1.1rem; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; padding: 30px; }
    .form-group { display: flex; flex-direction: column; margin-bottom: 15px; }
    .form-group label { margin-bottom: 8px; font-weight: 600; color: #333; font-size: .95rem; }
    .form-group input, .form-group select {
        padding: 12px 15px; border: 2px solid #e1e5eb; border-radius: 10px;
        font-size: 1rem; transition: all .3s ease; width: 100%; color: #333; background: #fff;
    }
    .form-group input:focus, .form-group select:focus {
        outline: none; border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,.1);
    }
    .hint { font-size: .78rem; color: #888; margin-top: 4px; }
    .btn { padding: 14px 28px; border: none; border-radius: 12px; font-size: 1rem; font-weight: 600; cursor: pointer; transition: all .3s ease; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; }
    .btn-primary { background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); color: #fff; box-shadow: 0 4px 15px rgba(102,126,234,.3); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(102,126,234,.4); }
    .btn-orange { background: #ff9800; color: #fff; }
    .btn-orange:hover { background: #f57c00; }
    .btn-success { background: #28a745; color: #fff; }
    .btn-success:hover { background: #218838; }
    .btn-warning { background: #ffc107; color: #212529; }
    .btn-warning:hover { background: #e0a800; }
    .btn-group { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; padding: 0 30px; }
    .table-wrapper { padding: 30px; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
    th { background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); color: #fff; padding: 15px; text-align: left; font-weight: 600; }
    td { padding: 15px; border-bottom: 1px solid #eee; }
    tr:last-child td { border-bottom: none; }
    tr:hover { background-color: #f8f9fa; }
    .empty-state { text-align: center; padding: 60px 20px; color: #6c757d; }
    .empty-state h3 { font-size: 1.5rem; margin-bottom: 10px; color: #495057; }
    .toast { position: fixed; top: 20px; right: 20px; background: #fff; padding: 16px 24px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,.2); transform: translateX(500px); transition: all .3s ease; z-index: 3000; max-width: 360px; font-size: .95rem; cursor: pointer; color: #333; }
    .toast.show { transform: translateX(0); }
    .toast.success { border-left: 4px solid #28a745; }
    .toast.error   { border-left: 4px solid #dc3545; }
    .toast.warning { border-left: 4px solid #ffc107; }
    .toast.info    { border-left: 4px solid #17a2b8; }
    .acciones { display: flex; gap: 6px; flex-wrap: wrap; }
    .btn-editar, .btn-eliminar, .btn-etiqueta {
        padding: 6px 10px; border: none; border-radius: 6px;
        cursor: pointer; font-size: 12px; font-weight: 600;
    }
    .btn-editar { background-color: #17a2b8; color: #fff; }
    .btn-editar:hover { background-color: #138496; }
    .btn-eliminar { background-color: #dc3545; color: #fff; }
    .btn-eliminar:hover { background-color: #c82333; }
    .btn-etiqueta { background-color: #ffc107; color: #212529; }
    .btn-etiqueta:hover { background-color: #e0a800; }
    .stock-agotado { color: #dc3545; font-weight: bold; background-color: #f8d7da; padding: 5px; border-radius: 3px; }
    .stock-bajo { color: #b8860b; font-weight: bold; background-color: #fff3cd; padding: 5px; border-radius: 3px; }

    .modal { display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,.55); }
    .modal-content { background-color: #fefefe; margin: 8% auto; padding: 25px; width: 92%; max-width: 520px; border-radius: 14px; box-shadow: 0 10px 40px rgba(0,0,0,.4); }
    .modal-content h2 { margin-bottom: 18px; color: #333; font-size: 1.3rem; }
    .close { color: #aaa; float: right; font-size: 30px; font-weight: bold; cursor: pointer; line-height: 1; }
    .close:hover { color: #000; }

    .modal-etiqueta-contenido { margin: 8% auto; width: 92%; max-width: 380px; text-align: center; }
    .ticket { background: #fff; border-radius: 14px; padding: 24px 20px 18px 20px; box-shadow: 0 10px 40px rgba(0,0,0,.4); border: 2px dashed #ccc; }
    .ticket .nombre { font-size: 1.15rem; font-weight: 700; color: #222; margin-bottom: 12px; word-wrap: break-word; }
    .ticket .precio { font-size: 2.6rem; font-weight: 900; color: #dc3545; line-height: 1.1; margin: 10px 0 4px 0; letter-spacing: -1px; }
    .ticket .precio small { font-size: 1.2rem; color: #dc3545; font-weight: 700; }
    .ticket .detalle { font-size: .82rem; color: #666; margin-top: 12px; padding-top: 12px; border-top: 1px dashed #ccc; }
    .ticket .detalle div { margin: 3px 0; }
    .ticket .marca { font-size: .78rem; color: #999; margin-top: 10px; font-style: italic; }
    .ticket-botones { display: flex; gap: 10px; margin-top: 16px; }
    .ticket-botones button { flex: 1; padding: 12px 10px; border: none; border-radius: 10px; font-size: .95rem; font-weight: 600; cursor: pointer; }
    .btn-ticket-print { background: #ff9800; color: #fff; }
    .btn-ticket-print:hover { background: #f57c00; }
    .btn-ticket-cerrar { background: #e0e0e0; color: #333; }
    .btn-ticket-cerrar:hover { background: #ccc; }

    @media print { .no-print { display: none !important; } body { background: #fff; padding: 0; } .container { box-shadow: none; max-width: 100%; } }
    @media (max-width: 768px) {
        .header h1 { font-size: 1.5rem; }
        .form-grid { grid-template-columns: 1fr; padding: 20px; }
        .btn-group { flex-direction: column; padding: 0 20px; }
        .btn { width: 100%; }
        .table-wrapper { padding: 15px; }
        th, td { padding: 10px; font-size: .9rem; }
    }
</style>
</head>
<body>

<div class="container" id="app">
    <div class="header">
        <h1>Calculadora Abasto Vanessa</h1>
        <p>Sistema profesional de calculo de precios y gestion de inventario</p>
    </div>

    <div class="form-grid">
        <div class="form-group">
            <label for="producto">Nombre del Producto</label>
            <input type="text" id="producto" placeholder="Ej: Harina Pan" autofocus autocomplete="off">
        </div>
        <div class="form-group">
            <label for="costo">Costo en Dolares ($)</label>
            <input type="number" id="costo" placeholder="0.00" step="0.01" min="0.01" inputmode="decimal">
            <span class="hint">Si compras por caja, escribe el costo TOTAL de la caja</span>
        </div>
        <div class="form-group">
            <label for="unidades">Unidades por Paquete/Caja</label>
            <input type="number" id="unidades" placeholder="1" value="1" step="1" min="1" inputmode="numeric">
            <span class="hint">Dejalo en 1 si es un producto suelto</span>
        </div>
        <div class="form-group">
            <label for="margen">Margen de Ganancia (%)</label>
            <input type="number" id="margen" placeholder="30" value="30" step="0.5" min="1" inputmode="decimal">
        </div>
        <div class="form-group">
            <label for="tasa">Tasa del Dolar (Bs)</label>
            <input type="number" id="tasa" placeholder="820" value="820" step="0.01" min="0.01" inputmode="decimal">
        </div>
    </div>

    <div style="padding: 0 30px 20px 30px;">
        <button class="btn btn-primary" id="btnAgregar">Anadir al Inventario</button>
    </div>

    <div class="btn-group no-print">
        <button class="btn btn-orange" id="btnActualizarTodos">Actualizar TODOS los precios</button>
        <button class="btn btn-success" id="btnExportarExcel">Descargar Excel</button>
        <button class="btn btn-warning" id="btnImprimirEtiquetas">Imprimir Etiquetas</button>
    </div>

    <div style="padding: 0 30px 15px 30px;">
        <input type="text" id="buscadorProducto" placeholder="&#128269; Buscar producto..."
            style="width:100%; padding:12px 15px; border:2px solid #e1e5eb; border-radius:10px; font-size:1rem; color:#333;">
    </div>

    <div class="table-wrapper">
        <table id="tablaInventario">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Costo Unit. $</th>
                    <th>Precio Final (Bs)</th>
                    <th>Stock</th>
                    <th class="no-print">Acciones</th>
                </tr>
            </thead>
            <tbody id="tablaBody"></tbody>
        </table>
        <div id="emptyState" class="empty-state">
            <h3>Inventario Vacio</h3>
            <p>Agrega tus primeros productos usando el formulario de arriba</p>
        </div>
    </div>
</div>

<div id="modalEditar" class="modal">
    <div class="modal-content">
        <span class="close" id="btnCerrarEditar">&times;</span>
        <h2>Editar Producto</h2>
        <div class="form-group">
            <label for="editarNombre">Nombre:</label>
            <input type="text" id="editarNombre">
        </div>
        <div class="form-group">
            <label for="editarCosto">Costo Total ($):</label>
            <input type="number" id="editarCosto" step="0.01" min="0.01" inputmode="decimal">
        </div>
        <div class="form-group">
            <label for="editarUnidades">Unidades:</label>
            <input type="number" id="editarUnidades" step="1" min="1" inputmode="numeric">
        </div>
        <div class="form-group">
            <label for="editarMargen">Margen (%):</label>
            <input type="number" id="editarMargen" step="0.5" min="1" inputmode="decimal">
        </div>
        <div class="form-group">
            <label for="editarTasa">Tasa (Bs):</label>
            <input type="number" id="editarTasa" step="0.01" min="0.01" inputmode="decimal">
        </div>
        <div class="form-group">
            <label for="editarStock">Stock actual:</label>
            <input type="number" id="editarStock" step="1" min="0" inputmode="numeric">
        </div>
        <div id="previewEditar" style="background:#f8f9fa; padding:12px; border-radius:8px; font-size:.9rem; color:#555; margin-bottom:10px;"></div>
        <button class="btn btn-success" id="btnGuardarEdicion" style="width:100%;">Guardar Cambios</button>
    </div>
</div>

<div id="modalEtiqueta" class="modal">
    <div class="modal-etiqueta-contenido">
        <div class="ticket" id="ticketContenido"></div>
        <div class="ticket-botones">
            <button class="btn-ticket-print" id="btnTicketPrint">Imprimir esta etiqueta</button>
            <button class="btn-ticket-cerrar" id="btnTicketCerrar">Cerrar</button>
        </div>
    </div>
</div>

<div id="toast" class="toast"></div>

<script>
let inventario = [];
let productoEnEtiqueta = null;
let productoEditando = null;

const CLAVE_LS = 'inventarioVanessa_v3';
const TASA_POR_DEFECTO = 820;
const MARGEN_POR_DEFECTO = 30;

const $ = (id) => document.getElementById(id);
const productoInput = $('producto');
const costoInput = $('costo');
const unidadesInput = $('unidades');
const margenInput = $('margen');
const tasaInput = $('tasa');
const tablaBody = $('tablaBody');
const tablaInventario = $('tablaInventario');
const emptyState = $('emptyState');
const toast = $('toast');
const modalEditar = $('modalEditar');
const modalEtiqueta = $('modalEtiqueta');
const ticketContenido = $('ticketContenido');

function num(v) {
    if (v === null || v === undefined) return NaN;
    const limpio = String(v).trim().replace(/\s/g, '').replace(',', '.');
    if (limpio === '') return NaN;
    const n = parseFloat(limpio);
    return Number.isFinite(n) ? n : NaN;
}

const fmtBs  = (n) => n.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmtUsd = (n) => n.toFixed(2);

function escaparHTML(str) {
    return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
}

function calcularPrecio(costoUnitario, margen, tasa) {
    let m = margen;
    if (m >= 100) m = 99;
    return (costoUnitario / (1 - m / 100)) * tasa;
}

let toastTimer = null;
function mostrarToast(mensaje, tipo, duracion) {
    tipo = tipo || 'info';
    duracion = duracion || 5000;
    toast.textContent = mensaje;
    toast.className = 'toast ' + tipo;
    void toast.offsetWidth;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), duracion);
}
toast.addEventListener('click', () => toast.classList.remove('show'));

function guardarInventarioLocal() {
    try { localStorage.setItem(CLAVE_LS, JSON.stringify(inventario)); }
    catch (e) { mostrarToast('No se pudo guardar', 'error'); }
}

function cargarInventarioLocal() {
    try {
        const raw = localStorage.getItem(CLAVE_LS) || localStorage.getItem('inventarioVanessa_v2') || localStorage.getItem('inventarioVanessa');
        if (!raw) return;
        const datos = JSON.parse(raw);
        if (!Array.isArray(datos)) return;
        inventario = datos.map(p => {
            const unidades = p.unidadesPaquete > 0 ? p.unidadesPaquete : 1;
            const costoUnit = Number.isFinite(p.costo) ? p.costo : ((p.costoOriginal || 0) / unidades);
            const margen = (Number.isFinite(p.margen) && p.margen > 0) ? p.margen : MARGEN_POR_DEFECTO;
            const tasa   = (Number.isFinite(p.tasa) && p.tasa > 0) ? p.tasa : TASA_POR_DEFECTO;
            return {
                id: p.id || (Date.now() + Math.random()),
                nombre: p.nombre || 'Sin nombre',
                costoOriginal: Number.isFinite(p.costoOriginal) ? p.costoOriginal : (costoUnit * unidades),
                unidadesPaquete: unidades,
                costo: costoUnit,
                margen: margen,
                tasa: tasa,
                precioFinal: Number.isFinite(p.precioFinal) ? p.precioFinal : calcularPrecio(costoUnit, margen, tasa),
                stock: Number.isFinite(p.stock) ? p.stock : unidades,
                fechaAgregado: p.fechaAgregado || new Date().toLocaleDateString()
            };
        });
        actualizarTabla();
    } catch (e) { console.error(e); }
}

function agregarProducto() {
    const nombre = productoInput.value.trim();
    if (!nombre) { mostrarToast('Ingresa el nombre del producto', 'warning'); productoInput.focus(); return; }
    const costoTotal = num(costoInput.value);
    if (!Number.isFinite(costoTotal) || costoTotal <= 0) { mostrarToast('Ingresa un costo valido mayor a 0', 'warning'); costoInput.focus(); return; }
    let unidades = parseInt(unidadesInput.value, 10);
    if (!Number.isFinite(unidades) || unidades < 1) unidades = 1;
    let margen = num(margenInput.value);
    if (!Number.isFinite(margen) || margen <= 0) { margen = MARGEN_POR_DEFECTO; margenInput.value = MARGEN_POR_DEFECTO; }
    if (margen >= 100) { margen = 99; margenInput.value = 99; mostrarToast('El margen se ajusto a 99%', 'info', 3000); }
    const tasaLeida = num(tasaInput.value);
    if (!Number.isFinite(tasaLeida) || tasaLeida <= 0) { mostrarToast('La tasa del dolar no es valida', 'warning'); tasaInput.focus(); return; }
    const costoUnitario = costoTotal / unidades;
    const precioFinal = calcularPrecio(costoUnitario, margen, tasaLeida);
    const existente = inventario.find(p =>
        p.nombre.toLowerCase() === nombre.toLowerCase() &&
        Math.abs(p.costo - costoUnitario) < 0.0001 &&
        p.margen === margen
    );
    if (existente) {
        existente.stock += unidades;
        existente.tasa = tasaLeida;
        existente.precioFinal = calcularPrecio(existente.costo, existente.margen, tasaLeida);
        guardarInventarioLocal();
        actualizarTabla();
        limpiarFormulario();
        mostrarToast('Stock sumado: ' + existente.nombre + ' ahora tiene ' + existente.stock + ' unidad(es)', 'success');
        return;
    }
    inventario.push({
        id: Date.now() + Math.floor(Math.random() * 1000),
        nombre: nombre, costoOriginal: costoTotal, unidadesPaquete: unidades,
        costo: costoUnitario, margen: margen, tasa: tasaLeida, precioFinal: precioFinal,
        stock: unidades, fechaAgregado: new Date().toLocaleDateString()
    });
    guardarInventarioLocal();
    actualizarTabla();
    limpiarFormulario();
    mostrarToast('Producto anadido correctamente', 'success', 3000);
}

function limpiarFormulario() {
    productoInput.value = '';
    costoInput.value = '';
    unidadesInput.value = '1';
    margenInput.value = MARGEN_POR_DEFECTO;
    productoInput.focus();
}

function actualizarTabla() {
    tablaBody.innerHTML = '';
    if (inventario.length === 0) {
        emptyState.style.display = 'block';
        tablaInventario.style.display = 'none';
        return;
    }
    emptyState.style.display = 'none';
    tablaInventario.style.display = 'table';
    const frag = document.createDocumentFragment();

    inventario.forEach(producto => {
        const fila = document.createElement('tr');
        fila.dataset.productoId = producto.id;
        let stockClass = '';
        if (producto.stock === 0) stockClass = 'stock-agotado';
        else if (producto.stock <= 5) stockClass = 'stock-bajo';

        const tdNombre = document.createElement('td');
        tdNombre.innerHTML = '<strong>' + escaparHTML(producto.nombre) + '</strong>';
        const tdCosto = document.createElement('td');
        tdCosto.textContent = '$' + fmtUsd(producto.costo);
        const tdPrecio = document.createElement('td');
        tdPrecio.innerHTML = '<strong>' + fmtBs(producto.precioFinal) + ' Bs</strong>';
        const tdStock = document.createElement('td');
        tdStock.className = stockClass;
        tdStock.innerHTML = '<strong>' + producto.stock + '</strong>';
        const tdAcciones = document.createElement('td');
        tdAcciones.className = 'acciones no-print';

        const btnEditar = document.createElement('button');
        btnEditar.className = 'btn-editar';
        btnEditar.textContent = 'Editar';
        btnEditar.addEventListener('click', () => abrirEditar(producto.id));

        const btnEliminar = document.createElement('button');
        btnEliminar.className = 'btn-eliminar';
        btnEliminar.textContent = 'Borrar';
        btnEliminar.addEventListener('click', () => eliminarProducto(producto.id));

        const btnEtiqueta = document.createElement('button');
        btnEtiqueta.className = 'btn-etiqueta';
        btnEtiqueta.textContent = 'Etiqueta';
        btnEtiqueta.addEventListener('click', () => mostrarEtiqueta(producto));

        tdAcciones.appendChild(btnEditar);
        tdAcciones.appendChild(btnEliminar);
        tdAcciones.appendChild(btnEtiqueta);
        fila.appendChild(tdNombre);
        fila.appendChild(tdCosto);
        fila.appendChild(tdPrecio);
        fila.appendChild(tdStock);
        fila.appendChild(tdAcciones);
        frag.appendChild(fila);
    });
    tablaBody.appendChild(frag);
}

function filtrarProductos() {
    const texto = $('buscadorProducto').value.toLowerCase().trim();
    const filas = tablaBody.querySelectorAll('tr');
    filas.forEach(fila => {
        const id = parseInt(fila.dataset.productoId, 10);
        const p = inventario.find(x => x.id === id);
        if (!p) return;
        fila.style.display = (!texto || p.nombre.toLowerCase().indexOf(texto) !== -1) ? '' : 'none';
    });
}

function abrirEditar(id) {
    const p = inventario.find(x => x.id === id);
    if (!p) return;
    productoEditando = p;
    $('editarNombre').value = p.nombre;
    $('editarCosto').value = p.costoOriginal.toFixed(2);
    $('editarUnidades').value = p.unidadesPaquete;
    $('editarMargen').value = p.margen;
    $('editarTasa').value = p.tasa;
    $('editarStock').value = p.stock;
    actualizarPreviewEditar();
    modalEditar.style.display = 'block';
}

function actualizarPreviewEditar() {
    const costoTotal = num($('editarCosto').value);
    const unidades = parseInt($('editarUnidades').value, 10) || 1;
    const margen = num($('editarMargen').value);
    const tasa = num($('editarTasa').value);
    if (!Number.isFinite(costoTotal) || !Number.isFinite(margen) || !Number.isFinite(tasa) || costoTotal <= 0) {
        $('previewEditar').textContent = 'Completa los campos para ver el resumen...';
        return;
    }
    const costoUnit = costoTotal / unidades;
    const precio = calcularPrecio(costoUnit, margen, tasa);
    $('previewEditar').innerHTML = 'Costo unitario: <strong>$' + fmtUsd(costoUnit) + '</strong><br>Precio de venta: <strong>' + fmtBs(precio) + ' Bs</strong>';
}

function guardarEdicion() {
    if (!productoEditando) return;
    const nombre = $('editarNombre').value.trim();
    const costoTotal = num($('editarCosto').value);
    const unidades = parseInt($('editarUnidades').value, 10);
    const margen = num($('editarMargen').value);
    const tasa = num($('editarTasa').value);
    const stock = parseInt($('editarStock').value, 10);
    if (!nombre) { mostrarToast('El nombre no puede estar vacio', 'warning'); return; }
    if (!Number.isFinite(costoTotal) || costoTotal <= 0) { mostrarToast('Costo invalido', 'warning'); return; }
    if (!Number.isFinite(unidades) || unidades < 1) { mostrarToast('Unidades debe ser al menos 1', 'warning'); return; }
    if (!Number.isFinite(margen) || margen <= 0 || margen >= 100) { mostrarToast('Margen invalido', 'warning'); return; }
    if (!Number.isFinite(tasa) || tasa <= 0) { mostrarToast('Tasa invalida', 'warning'); return; }
    if (!Number.isFinite(stock) || stock < 0) { mostrarToast('Stock invalido', 'warning'); return; }
    const costoUnit = costoTotal / unidades;
    productoEditando.nombre = nombre;
    productoEditando.costoOriginal = costoTotal;
    productoEditando.unidadesPaquete = unidades;
    productoEditando.costo = costoUnit;
    productoEditando.margen = margen;
    productoEditando.tasa = tasa;
    productoEditando.precioFinal = calcularPrecio(costoUnit, margen, tasa);
    productoEditando.stock = stock;
    guardarInventarioLocal();
    actualizarTabla();
    cerrarEditar();
    mostrarToast('Producto actualizado correctamente', 'success', 3000);
}

function cerrarEditar() {
    modalEditar.style.display = 'none';
    productoEditando = null;
}

function eliminarProducto(id) {
    const p = inventario.find(x => x.id === id);
    if (!p) return;
    if (!confirm('Eliminar "' + p.nombre + '" del inventario?')) return;
    inventario = inventario.filter(x => x.id !== id);
    guardarInventarioLocal();
    actualizarTabla();
    mostrarToast('Producto eliminado', 'success', 3000);
}

function actualizarTodosPrecios() {
    if (inventario.length === 0) { mostrarToast('No hay productos', 'info', 3000); return; }
    const nuevaTasa = num(tasaInput.value);
    if (!Number.isFinite(nuevaTasa) || nuevaTasa <= 0) { mostrarToast('Ingresa una tasa valida', 'warning'); return; }
    let contador = 0;
    inventario.forEach(p => {
        const nuevo = calcularPrecio(p.costo, p.margen, nuevaTasa);
        if (Math.abs(p.precioFinal - nuevo) > 0.001 || p.tasa !== nuevaTasa) {
            p.precioFinal = nuevo;
            p.tasa = nuevaTasa;
            contador++;
        }
    });
    if (contador === 0) { mostrarToast('Ningun producto necesitaba actualizacion', 'info', 3000); return; }
    guardarInventarioLocal();
    actualizarTabla();
    mostrarToast(contador + ' producto(s) actualizados a tasa ' + fmtBs(nuevaTasa) + ' Bs', 'success');
}

function construirTicketHTML(p) {
    return '<div class="nombre">' + escaparHTML(p.nombre) + '</div>' +
        '<div class="precio">' + fmtBs(p.precioFinal) + ' <small>Bs</small></div>' +
        '<div class="detalle">' +
            '<div>Costo: $' + fmtUsd(p.costo) + ' | Margen: ' + p.margen + '%</div>' +
            '<div>Tasa: ' + fmtBs(p.tasa) + ' Bs</div>' +
            '<div>Stock: ' + p.stock + ' unidad(es)</div>' +
        '</div>' +
        '<div class="marca">Abasto Vanessa</div>';
}

function mostrarEtiqueta(producto) {
    productoEnEtiqueta = producto;
    ticketContenido.innerHTML = construirTicketHTML(producto);
    modalEtiqueta.style.display = 'block';
}

function cerrarEtiqueta() {
    modalEtiqueta.style.display = 'none';
    productoEnEtiqueta = null;
}

function imprimirEtiquetas(lista) {
    const productos = (Array.isArray(lista) && lista.length) ? lista : inventario;
    if (!productos || productos.length === 0) { mostrarToast('No hay productos para imprimir', 'info', 3000); return; }

    // Detectar si es impresion individual (1 producto) o masiva
    const esIndividual = productos.length === 1;

    let cuerpo = '';
    if (esIndividual) {
        // Formato TIQUERA 58mm - etiqueta vertical
        const p = productos[0];
        cuerpo = '<div class="ticket">' +
            '<div class="nombre">' + escaparHTML(p.nombre) + '</div>' +
            '<div class="precio">' + fmtBs(p.precioFinal) + ' <small>Bs</small></div>' +
            '<div class="detalle">' +
                '<div>Costo: $' + fmtUsd(p.costo) + ' | Margen: ' + p.margen + '%</div>' +
                '<div>Tasa: ' + fmtBs(p.tasa) + ' Bs</div>' +
                '<div>Stock: ' + p.stock + ' unidad(es)</div>' +
            '</div>' +
            '<div class="marca">Abasto Vanessa</div>' +
        '</div>';
    } else {
        // Formato HOJA CARTA - grid 24 etiquetas
        productos.forEach(p => {
            cuerpo += '<div class="etiqueta">' +
                '<div class="nombre">' + escaparHTML(p.nombre) + '</div>' +
                '<div class="precio">' + fmtBs(p.precioFinal) + ' <small>Bs</small></div>' +
                '<div class="detalle">Costo: $' + fmtUsd(p.costo) + ' | Margen: ' + p.margen + '% | Stock: ' + p.stock + '</div>' +
                '<div class="marca">Abasto Vanessa</div>' +
            '</div>';
        });
    }

    const estiloIndividual =
    '@page { size: 58mm auto; margin: 0; }' +
    '* { box-sizing: border-box; }' +
    'html, body { margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; background: #fff; }' +
    'body { display: flex; justify-content: center; align-items: flex-start; min-height: 100vh; padding: 8mm 0; }' +
    '.ticket { text-align: center; padding: 6mm 3mm; width: 54mm; border: 1px dashed #ccc; border-radius: 6px; }' +
    '.nombre { font-size: 14px; font-weight: bold; color: #222; margin-bottom: 8px; word-wrap: break-word; line-height: 1.2; }' +
    '.precio { font-size: 28px; font-weight: 900; color: #dc3545; line-height: 1.1; margin: 8px 0; }' +
    '.precio small { font-size: 13px; }' +
    '.detalle { font-size: 11px; color: #666; margin-top: 8px; padding-top: 8px; border-top: 1px dashed #ccc; line-height: 1.4; }' +
    '.detalle div { margin: 1px 0; }' +
    '.marca { font-size: 10px; color: #999; margin-top: 8px; font-style: italic; }' +
    '@media print { body { padding: 0; } .ticket { border: none; } }';

    const estiloMasivo =
        '@page { size: letter portrait; margin: 0.4in; }' +
        '* { box-sizing: border-box; }' +
        'body { margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; background: #fff; }' +
        '.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }' +
        '.etiqueta { border: 1px dashed #999; border-radius: 6px; padding: 6px 8px; text-align: center; page-break-inside: avoid; min-height: 1.05in; display: flex; flex-direction: column; justify-content: center; }' +
        '.nombre { font-size: 10px; font-weight: bold; color: #222; margin-bottom: 3px; word-wrap: break-word; line-height: 1.15; }' +
        '.precio { font-size: 17px; font-weight: 900; color: #dc3545; line-height: 1; margin: 2px 0; }' +
        '.precio small { font-size: 9px; }' +
        '.detalle { font-size: 7px; color: #666; margin-top: 3px; line-height: 1.2; }' +
        '.marca { font-size: 7px; color: #999; font-style: italic; margin-top: 2px; }' +
        '@media print { body { padding: 0; } .etiqueta { border-style: solid; } }';

    const contenidoBody = esIndividual ? cuerpo : '<div class="grid">' + cuerpo + '</div>';

    const html = '<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Etiquetas</title>' +
        '<style>' + (esIndividual ? estiloIndividual : estiloMasivo) + '</style>' +
        '</head><body>' + contenidoBody + '</body></html>';

    const iframe = document.createElement('iframe');
    iframe.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden;';
    document.body.appendChild(iframe);
    const doc = iframe.contentWindow.document;
    doc.open(); doc.write(html); doc.close();
    setTimeout(() => {
        try { iframe.contentWindow.focus(); iframe.contentWindow.print(); }
        catch (e) { mostrarToast('No se pudo abrir impresion', 'warning'); }
        setTimeout(() => { if (iframe.parentNode) iframe.parentNode.removeChild(iframe); }, 1500);
    }, 400);

    if (esIndividual) {
        mostrarToast('Preparando etiqueta para tiquera...', 'info', 3000);
    } else {
        mostrarToast('Preparando ' + productos.length + ' etiqueta(s)...', 'info', 3000);
    }
}

function exportarExcel() {
    if (inventario.length === 0) { mostrarToast('No hay productos para exportar', 'info', 3000); return; }
    if (typeof XLSX === 'undefined') { mostrarToast('Sin conexion. Revisa internet.', 'warning'); return; }
    const datos = [
        ['Nombre', 'Costo Caja $', 'Unidades/Caja', 'Costo Unit. $', 'Margen %', 'Precio Final Bs', 'Tasa Bs', 'Stock', 'Fecha']
    ];
    inventario.forEach(p => {
        datos.push([
            p.nombre, parseFloat(fmtUsd(p.costoOriginal)), p.unidadesPaquete,
            parseFloat(fmtUsd(p.costo)), p.margen, parseFloat(fmtUsd(p.precioFinal)),
            parseFloat(fmtUsd(p.tasa)), p.stock, p.fechaAgregado
        ]);
    });
    const ws = XLSX.utils.aoa_to_sheet(datos);
    ws['!cols'] = [{wch:25},{wch:12},{wch:14},{wch:13},{wch:10},{wch:15},{wch:10},{wch:8},{wch:12}];
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Inventario');
    const wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
    const blob = new Blob([wbout], { type: 'application/octet-stream' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'inventario_vanessa_' + new Date().toISOString().split('T')[0] + '.xlsx';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    mostrarToast('Inventario exportado', 'success', 3000);
}

$('btnAgregar').addEventListener('click', agregarProducto);
$('btnActualizarTodos').addEventListener('click', actualizarTodosPrecios);
$('btnExportarExcel').addEventListener('click', exportarExcel);
$('btnImprimirEtiquetas').addEventListener('click', () => imprimirEtiquetas());
$('buscadorProducto').addEventListener('input', filtrarProductos);
$('btnCerrarEditar').addEventListener('click', cerrarEditar);
$('btnGuardarEdicion').addEventListener('click', guardarEdicion);
['editarCosto', 'editarUnidades', 'editarMargen', 'editarTasa'].forEach(id => {
    $(id).addEventListener('input', actualizarPreviewEditar);
});
$('btnTicketCerrar').addEventListener('click', cerrarEtiqueta);
$('btnTicketPrint').addEventListener('click', () => { if (productoEnEtiqueta) { imprimirEtiquetas([productoEnEtiqueta]); cerrarEtiqueta(); } });

[productoInput, costoInput, unidadesInput, margenInput, tasaInput].forEach(el => {
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); agregarProducto(); } });
});

[modalEditar, modalEtiqueta].forEach(m => {
    m.addEventListener('click', (e) => {
        if (e.target === m) {
            if (m === modalEditar) cerrarEditar();
            else cerrarEtiqueta();
        }
    });
});

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        if (modalEditar.style.display === 'block') cerrarEditar();
        if (modalEtiqueta.style.display === 'block') cerrarEtiqueta();
    }
});
/* Guardar la última tasa usada */
const CLAVE_TASA = 'tasaVanessaUltima';
tasaInput.addEventListener('input', () => {
    localStorage.setItem(CLAVE_TASA, tasaInput.value);
});
const tasaGuardada = localStorage.getItem(CLAVE_TASA);
if (tasaGuardada) tasaInput.value = tasaGuardada;
cargarInventarioLocal();
actualizarTabla();

/* Registrar Service Worker para uso offline */
if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw2.js')
            .then(() => console.log('SW activo - app funciona offline'))
            .catch(err => console.log('SW no disponible:', err));
    });
}
</script>
</body>
</html>
